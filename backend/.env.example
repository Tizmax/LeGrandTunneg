# Copier ce fichier en .env et renseigner de vraies valeurs en local.
# Ne jamais committer de vraies valeurs ni le fichier .env lui-même.

# Future Railway Postgres URL. Placeholder only; do not provision a substitute.
# The persistence repository requires it; current room orchestration is NOT wired.
DATABASE_URL=postgresql://USER:PASSWORD@FUTURE_DATABASE_HOST/DATABASE_NAME
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=5
DB_TRANSACTION_TIMEOUT_SECONDS=10
DB_RECONCILE_TIMEOUT_SECONDS=10
DB_CLEANUP_TIMEOUT_SECONDS=2
# verify-full: system CA trust + hostname validation, no TLS downgrade.
# private-network: explicit plaintext, only for hosts ending .railway.internal.
DB_TLS_MODE=verify-full

# Optional future integration tests, dedicated database name must end in _test.
# TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@FUTURE_DATABASE_HOST/DEDICATED_test
# TEST_DATABASE_ACK=dedicated-disposable-database

# Port d'écoute HTTP. Railway injecte dynamiquement sa propre valeur ; 8000
# sert de valeur par défaut pour le développement local.
PORT=8000

# Settings are loaded from process environment (load .env in your local shell).
# Production requires APP_ENV=production and an explicit HTTPS allowlist, e.g.
# ALLOWED_ORIGINS=https://your-service.up.railway.app
# Use browser-serialized origins: lowercase hosts, no default ports or trailing '/'.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Empty disables forwarded scheme/client headers. Never set this to '*'.
# Only list proxy IPs/CIDRs or socket paths explicitly trusted by the operator.
TRUSTED_PROXY_HOPS=

MAX_ROOMS=10
MAX_PLAYERS=16
MAX_SCREENS=4
MAX_THEMES=32
MAX_NAME_CHARS=24
MAX_THEME_LABEL_CHARS=100
MAX_MESSAGE_BYTES=8192
MAX_REST_BODY_BYTES=8192
REST_BODY_TIMEOUT_SECONDS=5
MAX_REST_BODY_READERS=32
AUTH_TIMEOUT_SECONDS=5
MAX_PREAUTH_CONNECTIONS=32
MAX_AUTHENTICATED_CONNECTIONS=200
SEND_TIMEOUT_SECONDS=2
ROOM_IDLE_TTL_SECONDS=86400
ROOM_CLEANUP_INTERVAL_SECONDS=60
REST_RATE_PER_SECOND=5
REST_RATE_BURST=20
WS_UPGRADE_RATE_PER_SECOND=10
WS_UPGRADE_RATE_BURST=20
WS_COMMAND_RATE_PER_SECOND=20
WS_COMMAND_RATE_BURST=40
WS_GLOBAL_RATE_PER_SECOND=200
WS_GLOBAL_RATE_BURST=400

# Use python -m app.serve for the bounded single-worker WS transport.
