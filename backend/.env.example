# Copier ce fichier en .env et renseigner de vraies valeurs en local.
# Ne jamais committer de vraies valeurs ni le fichier .env lui-même.

# URL de connexion Postgres (driver async asyncpg), fournie automatiquement
# par Railway en production via la variable DATABASE_URL du plugin Postgres.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/legrandtunneg

# Clé secrète applicative (sessions, signatures, etc.). Générer une valeur
# aléatoire forte en production, ne jamais utiliser cet exemple tel quel.
SECRET_KEY=change-me-dev-secret-key

# Port d'écoute HTTP. Railway injecte dynamiquement sa propre valeur ; 8000
# sert de valeur par défaut pour le développement local.
PORT=8000
